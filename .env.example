
# Port the server listens on in production (most hosts set PORT for you).
PORT=3001

# Port of the game server during `npm run dev` (Vite proxies /socket.io to it).
SERVER_PORT=3001

# Directory for the room snapshot file used to survive restarts. Must be writable.
# Leave empty to use ./data. Set PERSISTENCE=off to keep rooms in memory only.
DATA_DIR=
PERSISTENCE=on

# Comma-separated list of allowed browser origins for WebSocket connections in production.
# Leave empty to allow only same-origin requests (the normal setup when the server serves the client).
ALLOWED_ORIGINS=

# Set to 1 when running behind a reverse proxy (Render, Fly, Nginx) so client IPs used for
# rate limiting come from X-Forwarded-For.
TRUST_PROXY=0
